{
  "manifest_version": 3,
  "name": "Canvas Quiz Compiler",
  "version": "2.0.0",
  "description": "Capture Canvas quiz questions and answers for organized offline review.",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://*.instructure.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Open Quiz Compiler",
    "default_icon": {
      "16": "icons/icon16.png", "32": "icons/icon32.png",
      "48": "icons/icon48.png", "128": "icons/icon128.png"
    }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "commands": {
    "run_compiler": {
      "suggested_key": { "default": "Alt+R" },
      "description": "Capture visible Canvas quiz questions"
    }
  },
  "icons": {
    "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"
  },
  "content_scripts": [{
    "matches": ["https://*.instructure.com/courses/*/quizzes/*", "https://*.instructure.com/courses/*/assignments/*"],
    "js": ["contentScript.js"],
    "run_at": "document_idle"
  }]
}
